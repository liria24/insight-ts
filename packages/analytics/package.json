{
    "name": "@liria24/analytics",
    "version": "0.0.0",
    "description": "Provider-independent analytics for TypeScript applications",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/analytics.git",
        "directory": "packages/analytics"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare.d.ts",
            "import": "./dist/cloudflare.js"
        },
        "./google-search-console": {
            "types": "./dist/google-search-console.d.ts",
            "import": "./dist/google-search-console.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.js"
        },
        "./nuxt/runtime": {
            "types": "./dist/nuxt-runtime.d.ts",
            "import": "./dist/nuxt-runtime.js"
        },
        "./provider": {
            "types": "./dist/provider.d.ts",
            "import": "./dist/provider.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "import": "./dist/vue.js"
        },
        "./vue/style.css": "./dist/vue/style.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "prepack": "bun run build",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "unstorage": "^1.17.5"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@types/bun": "^1.4.0",
        "publint": "^0.3.24",
        "tsdown": "^0.22.14",
        "typescript": "6.0.3",
        "unplugin-vue": "^7.2.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "peerDependencies": {
        "h3": "^1.15",
        "nuxt": "^4.5.1",
        "vue": "^3.5.41",
        "vue-data-ui": "^3.23.9"
    },
    "peerDependenciesMeta": {
        "h3": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "vue-data-ui": {
            "optional": true
        }
    }
}
