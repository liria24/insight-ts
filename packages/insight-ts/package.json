{
    "name": "insight-ts",
    "version": "0.0.1-alpha.0",
    "description": "Typed insights across analytics, observability, and application data",
    "homepage": "https://insight.liria.me",
    "bugs": {
        "url": "https://github.com/liria24/insight-ts/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/insight-ts.git",
        "directory": "packages/insight-ts"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare.d.ts",
            "import": "./dist/cloudflare.js"
        },
        "./google-search-console": {
            "types": "./dist/google-search-console.d.ts",
            "import": "./dist/google-search-console.js"
        },
        "./history": {
            "types": "./dist/history.d.ts",
            "import": "./dist/history.js"
        },
        "./metrics": {
            "types": "./dist/metrics.d.ts",
            "import": "./dist/metrics.js"
        },
        "./nitro": {
            "types": "./dist/nitro.d.ts",
            "import": "./dist/nitro.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.js"
        },
        "./opentelemetry": {
            "types": "./dist/opentelemetry.d.ts",
            "import": "./dist/opentelemetry.js"
        },
        "./provider": {
            "types": "./dist/provider.d.ts",
            "import": "./dist/provider.js"
        },
        "./ui-core": {
            "types": "./dist/ui-core.d.ts",
            "import": "./dist/ui-core.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "import": "./dist/vue.js"
        },
        "./vue/ui": {
            "types": "./dist/vue-ui.d.ts",
            "import": "./dist/vue-ui.js"
        },
        "./vue/ui/style.css": "./dist/vue/ui/style.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "prepack": "bun run build",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@tanstack/charts": "0.16.0",
        "d3-shape": "3.2.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@opentelemetry/api": "^1.9.1",
        "@tsdown/css": "^0.22.14",
        "@types/bun": "^1.4.0",
        "@vue/compiler-sfc": "3.5.42",
        "happy-dom": "^20.11.15",
        "publint": "^0.3.24",
        "tsdown": "^0.22.14",
        "typescript": "6.0.3",
        "unplugin-vue": "^7.2.0",
        "unstorage": "^1.17.5",
        "vitest": "^4.1.11",
        "vue-compiler-36": "npm:@vue/compiler-sfc@3.6.0-rc.6",
        "vue-tsc": "^3.3.11"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "nuxt": "^4.5.1",
        "vue": ">=3.5.0"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/api": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    }
}
